# Normalise text files to LF.
* text=auto eol=lf

# Media and binary assets: never diff or merge as text.
*.mp4 binary
*.mov binary
*.wav binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated files: collapse in diffs and exclude from language stats.
Content/Production/package-lock.json linguist-generated=true -diff
Content/Ads/*/asset-manifest.csv linguist-generated=true

# Vendored third-party files: keep upstream bytes exactly (no line-ending changes).
Content/Production/assets/fonts/** -text
